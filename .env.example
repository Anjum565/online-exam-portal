# Server & Port Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas Free Tier - 512MB M0 Cluster)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/exam_system_db?retryWrites=true&w=majority

# Authentication Secret Key (Random long string)
JWT_SECRET=free_tier_exam_system_jwt_secret_key_change_in_production_2026

# Google Gemini API Free Tier Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy_YOUR_FREE_TIER_GEMINI_API_KEY_HERE

# Cloud Storage Credentials (Cloudinary Free Tier - 25GB)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Frontend API URL (Used during deployment)
VITE_API_BASE_URL=http://localhost:5000/api
